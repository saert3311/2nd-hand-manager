msgstr "Producto identificado"

msgid "Analysis completed!"
msgstr "¡Análisis completado!"

msgid "Identification notice"
msgstr "Aviso de identificación"

msgid "Could not identify product from photos."
msgstr "No se pudo identificar el producto a partir de las fotos."

msgid "AI pre-check skipped"
msgstr "Comprobación de IA omitida"

msgid "Network error"
msgstr "Error de red"

msgid "Target Sale Price"
msgstr "Precio de venta objetivo"

msgid "If price is already known. Can also be set later in staging."
msgstr "Si el precio ya se conoce. También se puede fijar más tarde en la preparación."

msgid "Please attach at least one photo to identify the product."
msgstr "Por favor, adjunta al menos una foto para identificar el producto."

msgid "Method not allowed. Use POST."
msgstr "Método no permitido. Usa POST."

msgid "Please attach at least one photo of the product before saving."
msgstr "Por favor, adjunta al menos una foto del producto antes de guardar."

msgid "The file '%(name)s' exceeds the 10MB limit (%(size)s MB). Please select photos under 10MB."
msgstr "El archivo '%(name)s' supera el límite de 10MB (%(size)s MB). Por favor, selecciona fotos menores de 10MB."

msgid "Please enter a valid, non-negative price."
msgstr "Por favor, introduce un precio válido no negativo."

msgid "Saving product..."
msgstr "Guardando producto..."

msgid "Please wait for AI analysis to finish..."
msgstr "Espera a que finalice el análisis con IA..."


msgid "Open menu"
msgstr "Abrir menú"

msgid "Close menu"
msgstr "Cerrar menú"

msgid "Mobile navigation"
msgstr "Navegación móvil"

