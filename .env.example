SECRET_KEY=django-insecure-dev-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=*
PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: External PostgreSQL database URL (defaults to SQLite if not provided)
# DATABASE_URL=postgres://user:password@localhost:5432/secondhand_db

# Oracle Cloud Infrastructure (OCI) Object Storage (S3-Compatible API)
OCI_STORAGE_BUCKET_NAME=my-secondhand-images-bucket
OCI_STORAGE_ACCESS_KEY=your_oci_customer_secret_access_key
OCI_STORAGE_SECRET_KEY=your_oci_customer_secret_key
OCI_STORAGE_NAMESPACE=your_tenancy_namespace
OCI_STORAGE_REGION=eu-madrid-1
# Optional: explicitly override the endpoint URL if using custom domain
# OCI_STORAGE_ENDPOINT_URL=https://your_tenancy_namespace.compat.objectstorage.eu-madrid-1.oraclecloud.com

# Cloudflare Turnstile Bot Protection (Optional - set to enable Turnstile challenge on login forms)
# For local dev / testing, you can use Cloudflare's official dummy keys:
# Always passes: Sitekey: 1x00000000000000000000AA, Secret: 1x0000000000000000000000000000000AA
# Always fails:  Sitekey: 2x00000000000000000000AB, Secret: 2x0000000000000000000000000000000AB
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=5.0

# Database Backup to OCI Object Storage
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_PREFIX=backups/db/

